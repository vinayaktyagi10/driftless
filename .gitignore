/CLAUDE.md
/DECISIONS.md

# data & models
/training/data/
*.ckpt
*.pt
*.onnx
*.onnx.data
*.tflite

# ...but DO track the exported models role 01 and roles 04-05 consume, so nobody
# needs the 425 MB dataset or a training run just to build the app. 312 KB total,
# and each is verified against PyTorch to ~1e-6 before it is written (see
# training/artifacts/models/export_report.json).
!/training/artifacts/models/*.onnx
!/training/artifacts/models/*.tflite

# Deliberately NOT un-ignored: *.onnx.data. The ONNX export now keeps its
# weights inline (export.py, external_data=False), so a sidecar appearing here
# means a stale file from an older export -- which would be loaded in
# preference to nothing and silently shadow the current weights.

# env
.env
.venv/
__pycache__/
*.pyc

# Android / Gradle
/android/.gradle/
/android/local.properties
/android/app/build/
/android/build/
/android/.idea/
*.apk
*.aab
*.zip
bugreport-*.zip

# C++ build
/edge-engine/build/
/edge-engine/third_party/*
!/edge-engine/third_party/.gitkeep

# OS
.DS_Store

# Transient: written after each cross-validation fold so an interrupted run
# keeps its completed folds; deleted when crossval.json is written.
/training/artifacts/metrics/crossval_partial.json

# Non-canonical evaluation outputs. Only the `--split test` run owns the
# unsuffixed artifact names and the top-level plots dir; val/train sweeps are a
# tuning aid, not a published result.
/training/artifacts/plots/*/
/training/artifacts/metrics/eval_summary_*.json
/training/artifacts/metrics/eval_per_run_*.csv
/training/artifacts/metrics/eval_blackouts_*.csv
